{
	"name": "agentic-inbox-dev",
	"main": "./workers/app.ts",
	"compatibility_date": "2025-11-28",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"observability": {
		"enabled": true,
	},
	"vars": {
		"DOMAINS": "dev.jdtogo.ai",
		"EMAIL_ADDRESSES": [],
		"MCP_ENABLED": "false",
		"DEPLOYMENT_ENV": "dev",
		"BACKUP_MODE": "notification",
		"BACKUP_FROM": "inbox-notify@jdtogo.ai",
		"BACKUP_EMAIL": "dev@jdtogo.com",
		"BACKUP_DEV_EMAIL": "dev@jdtogo.com",
	},
	"send_email": [
		{
			"name": "EMAIL",
			"destination_address": "dev@jdtogo.com",
			"allowed_sender_addresses": ["inbox-notify@jdtogo.ai"],
		},
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "agentic-inbox-dev-backup",
		},
	],
	"ai": {
		"binding": "AI",
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "MAILBOX",
				"class_name": "MailboxDO",
			},
			{
				"name": "EMAIL_AGENT",
				"class_name": "EmailAgent",
			},
			{
				"name": "EMAIL_MCP",
				"class_name": "EmailMCP",
			},
			{
				"name": "FILE_INDEX",
				"class_name": "FileIndexDO",
			},
			{
				"name": "BACKUP_DELIVERY",
				"class_name": "BackupDeliveryDO",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"MailboxDO",
				"EmailAgent",
				"EmailMCP",
				"FileIndexDO",
				"BackupDeliveryDO",
			],
		},
	],
	"routes": [
		{
			"pattern": "inbox-dev.jdtogo.ai",
			"custom_domain": true,
		},
	],
}
